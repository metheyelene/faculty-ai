# Copy this file to `keystore.properties` (gitignored) and fill in your values.
# The release build reads it to sign the APK/AAB. Never commit the real file.
#
#   cp keystore.properties.example keystore.properties
#
storeFile=/absolute/or/project-relative/path/to/your-release-key.jks
storePassword=your-keystore-password
keyAlias=acadora
keyPassword=your-key-password
